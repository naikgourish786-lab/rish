#include <stdio.h>
int main() {
    int a[2][3] = {{10, 20, 30}, {40, 50, 60}};
    int key, i, j, found = 0;
    printf("Enter element to search: ");
    scanf("%d", &key);

    for (i = 0; i < 2; i++) {
        for (j = 0; j < 3; j++) {
            if (a[i][j] == key) {
                printf("Element found at [%d][%d]\n", i, j);
                found = 1;
            }
        }
    }
    if (!found)
        printf("Element not found");
    return 0;
}

